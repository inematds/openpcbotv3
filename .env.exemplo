# openpcbot v3 — só o que é específico deste bot. Keys compartilhadas (OpenRouter,
# Anthropic, Groq, Google, etc.) e ALLOWED_CHAT_ID vêm em runtime de
# ~/projetos/openpcbotv2/.env (carregarEnv) — não duplique aqui.

# Token PRÓPRIO do bot v3 (crie no BotFather). NUNCA o do v2 — o v3 recusa.
TELEGRAM_BOT_TOKEN_V3=

PORT_V3=3142
PISO_RAM_GB=40
ORCAMENTO_MENSAL_USD=50

# Protege / e /api/* do dashboard (health continua aberto):
# DASHBOARD_TOKEN_V3=um-segredo

# Canais que o v2 ainda é dono — ligar só depois do corte:
# SLACK_ENABLED=1
# SLACK_CHANNELS=C0123,C0456
# WHATSAPP_ENABLED=1

# Backup cifrado (padrão Hermes) — sem isto o backup noturno usa gzip:
# AGE_RECIPIENT=age1...

# HTTP escuta só em 127.0.0.1 por padrão (POST /mensagem dispara agente com permissões).
# Expor na LAN só com token: HTTP_BIND_V3=0.0.0.0 + DASHBOARD_TOKEN_V3=...
# HTTP_BIND_V3=127.0.0.1
