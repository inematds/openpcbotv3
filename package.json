{
  "name": "openpcbotv3",
  "version": "3.1.1",
  "description": "openpcbot v3 — assistente pessoal multicanal com fila durável, gestor do Ollama, custo por chamada e cérebro com aprendizado",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node --max-old-space-size=1024 dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "doctor": "tsx src/cli/doctor.ts",
    "cli": "tsx src/cli/chat.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.5.0",
    "grammy": "^1.45.1",
    "js-yaml": "^4.1.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  },
  "engines": { "node": ">=20" }
}
